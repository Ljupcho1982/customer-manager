@namespace blazor_project.Components.Shared.Components

<div class="search-bar-container mb-4">
    <div class="search-bar">
        <div class="input-group">
            <span class="input-group-text">
                <i class="fas fa-search"></i>
            </span>
            <InputText 
                class="form-control" 
                placeholder="Search customers..."
                @bind-Value="SearchTerm"
                @onkeyup="OnSearchInput"
            />
            @if (!string.IsNullOrEmpty(SearchTerm))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    <i class="fas fa-times"></i>
                </button>
            }
        </div>
    </div>

    <button class="btn btn-outline-secondary" type="button" @onclick="ToggleAdvancedFilters">
        <i class="fas fa-filter me-2"></i>
        Advanced Filters
    </button>

    @if (ShowAdvancedFilters)
    {
        <div class="advanced-filters mt-3 p-3 border rounded">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="Status">
                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Archived">Archived</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">City</label>
                    <InputText class="form-control" @bind-Value="City" placeholder="Filter by city" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Country</label>
                    <InputText class="form-control" @bind-Value="Country" placeholder="Filter by country" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">From Date</label>
                    <InputDate class="form-control" @bind-Value="FromDate" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">To Date</label>
                    <InputDate class="form-control" @bind-Value="ToDate" />
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="button" @onclick="ApplyFilters">
                    <i class="fas fa-search me-2"></i>
                    Search
                </button>
                <button class="btn btn-secondary" type="button" @onclick="ClearFilters">
                    <i class="fas fa-times me-2"></i>
                    Clear Filters
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<SearchCriteria> OnSearch { get; set; }

    private string SearchTerm { get; set; } = string.Empty;
    private bool ShowAdvancedFilters { get; set; }
    private string? Status { get; set; }
    private string? City { get; set; }
    private string? Country { get; set; }
    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }

    private void ToggleAdvancedFilters()
    {
        ShowAdvancedFilters = !ShowAdvancedFilters;
    }

    private async Task OnSearchInput(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task ApplyFilters()
    {
        var criteria = new SearchCriteria
        {
            SearchTerm = SearchTerm,
            Status = Status,
            City = City,
            Country = Country,
            FromDate = FromDate,
            ToDate = ToDate,
            PageNumber = 1,
            PageSize = 10
        };

        await OnSearch.InvokeAsync(criteria);
    }

    private async Task ClearSearch()
    {
        SearchTerm = string.Empty;
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        SearchTerm = string.Empty;
        Status = null;
        City = null;
        Country = null;
        FromDate = null;
        ToDate = null;
        ShowAdvancedFilters = false;
        await ApplyFilters();
    }
}
